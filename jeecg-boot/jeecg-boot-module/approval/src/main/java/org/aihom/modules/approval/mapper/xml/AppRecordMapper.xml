<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.aihom.modules.approval.mapper.AppRecordMapper">

	<delete id="deleteByMainId" parameterType="java.lang.String">
		DELETE 
		FROM  app_record 
		WHERE
			 project_id = #{mainId} 	</delete>
	
	<select id="selectByMainId" parameterType="java.lang.String" resultType="org.aihom.modules.approval.entity.AppRecord">
		SELECT * 
		FROM  app_record
		WHERE
			 project_id = #{mainId} 	</select>
</mapper>
